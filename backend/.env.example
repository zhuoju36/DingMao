# ====== 应用 ======
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production-32-chars-min
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ====== 数据库 ======
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dingmao
POSTGRES_PASSWORD=dingmao_dev_password
POSTGRES_DB=dingmao

# ====== Redis ======
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ====== LLM ======
# 主力: MiniMax-M3
MINIMAX_API_KEY=your-minimax-api-key-here
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-M3

# 备用: DeepSeek-V4-Flash
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# 兜底（可选）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# LLM 路由
LLM_DEFAULT=minimax
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ====== 对象存储（腾讯云 COS） ======
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=dingmao-files-dev

# ====== 文件存储（P0-7-A）======
# 上传文件 + 解析产物的根目录（相对 backend/，也可写绝对路径）
STORAGE_ROOT=storage

# ====== MinerU 文档解析（P0-7-B）======
# 【重要】MinerU 依赖体积 7.3 GB（torch/onnxruntime + 模型），不装进 backend venv。
# 后端通过 subprocess 调用这里指定的解释器执行 MINERU_PARSE_SCRIPT。
#
# 本地开发：实验环境已装好，指向它即可
#   MINERU_PYTHON=../experiments/mineru-test/.venv/bin/python
# 生产部署：需在镜像/宿主机上准备一个装了 mineru 的 venv，填其绝对路径
#   MINERU_PYTHON=/opt/mineru-venv/bin/python
#
# 留空 = 未配置：上传仍可用，但解析会以明确错误失败（failed_parse）
MINERU_PYTHON=
MINERU_PARSE_SCRIPT=scripts/mineru_parse.py

# 解析档位：flash（CPU 可跑，MVP 默认）/ basic / standard / advanced
# standard 需 GPU（vLLM）；本机 GTX 1080 不支持，详见
# experiments/mineru-test/decisions-and-results.md
MINERU_TIER=flash

# 单文件解析超时（秒）。实测：~5s/3页、~135s/20页
MINERU_TIMEOUT=1800

# ====== 任务队列（ARQ，P0-7-B）======
# 启动 worker：cd backend && .venv/bin/arq app.worker.WorkerSettings
WORKER_MAX_JOBS=2
WORKER_JOB_TIMEOUT=2400

# ====== JWT ======
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440